 		ops = dpll_pin_ops(ref);
 		dpll = ref->dpll;
 		if (ops->frequency_set(pin, dpll_pin_on_dpll_priv(dpll, pin),
@@ -981,6 +1010,8 @@ dpll_pin_esync_set(struct dpll_pin *pin, struct nlattr *a,
