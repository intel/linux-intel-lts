 	dpll = ref->dpll;
 	ret = ops->esync_get(pin, dpll_pin_on_dpll_priv(dpll, pin), dpll,
@@ -1011,6 +1046,8 @@ dpll_pin_esync_set(struct dpll_pin *pin, struct nlattr *a,
