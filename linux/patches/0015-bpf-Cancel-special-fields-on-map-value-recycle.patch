 	if (l == tgt_l)
-		check_and_free_fields(htab, l);
+		check_and_cancel_fields(htab, l);
 	return l == tgt_l;
 }
 
@@ -969,7 +973,7 @@ static int htab_map_get_next_key(struct bpf_map *map, void *key, void *next_key)
 
