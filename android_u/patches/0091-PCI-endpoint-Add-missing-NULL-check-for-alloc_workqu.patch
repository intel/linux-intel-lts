From 573607181fe9a2b382a88cb0cb5829fc219dcc2f Mon Sep 17 00:00:00 2001
From: Sean Lim <pohkeng.lim@intel.com>
Date: Fri, 24 Jul 2026 17:00:53 +0800
Subject: [PATCH] PCI: endpoint: Add missing NULL check for alloc_workqueue()

alloc_workqueue() can return NULL on memory allocation failure. Without
proper error checking, this may lead to a NULL pointer dereference when
queue_work() is later called with the NULL workqueue pointer in
epf_ntb_epc_init().

Add a NULL check immediately after alloc_workqueue() and return -ENOMEM on
failure to prevent the driver from loading with an invalid workqueue
pointer.

Fixes: e35f56bb0330 ("PCI: endpoint: Support NTB transfer between RC and EP")
Fixes: 8b821cf76150 ("PCI: endpoint: Add EP function driver to provide NTB functionality")

This is a manual backport of upstream commit
03f336a869b3a3f119d3ae52ac9723739c7fb7b6, applied via the stable-tree
commit 314eab6740bcda504ef978be599f805de05ce6de (CVE-2025-71313). The
upstream commit could not be cherry-picked directly because it is not
present in this repository's object history and its context (workqueue
allocation flags include WQ_PERCPU which does not exist in this branch)
differs from this branch's older code shape. The fix itself -- adding a
NULL check after alloc_workqueue() and returning -ENOMEM on failure -- is
applied unchanged to both pci-epf-ntb.c and pci-epf-vntb.c to match
upstream intent exactly.

(cherry picked from commit 03f336a869b3a3f119d3ae52ac9723739c7fb7b6)
Signed-off-by: Sean Lim <pohkeng.lim@intel.com>
---
 drivers/pci/endpoint/functions/pci-epf-ntb.c  | 5 +++++
 drivers/pci/endpoint/functions/pci-epf-vntb.c | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/drivers/pci/endpoint/functions/pci-epf-ntb.c b/drivers/pci/endpoint/functions/pci-epf-ntb.c
index 8673c16ffb864..694b495ce3cb8 100644
--- a/drivers/pci/endpoint/functions/pci-epf-ntb.c
+++ b/drivers/pci/endpoint/functions/pci-epf-ntb.c
@@ -2078,6 +2078,11 @@ static int __init epf_ntb_init(void)
 
 	kpcintb_workqueue = alloc_workqueue("kpcintb", WQ_MEM_RECLAIM |
 					    WQ_HIGHPRI, 0);
+	if (!kpcintb_workqueue) {
+		pr_err("Failed to allocate kpcintb workqueue\n");
+		return -ENOMEM;
+	}
+
 	ret = pci_epf_register_driver(&epf_ntb_driver);
 	if (ret) {
 		destroy_workqueue(kpcintb_workqueue);
diff --git a/drivers/pci/endpoint/functions/pci-epf-vntb.c b/drivers/pci/endpoint/functions/pci-epf-vntb.c
index e9402b5dc8359..fb9bb170aff0e 100644
--- a/drivers/pci/endpoint/functions/pci-epf-vntb.c
+++ b/drivers/pci/endpoint/functions/pci-epf-vntb.c
@@ -1388,6 +1388,11 @@ static int __init epf_ntb_init(void)
 
 	kpcintb_workqueue = alloc_workqueue("kpcintb", WQ_MEM_RECLAIM |
 					    WQ_HIGHPRI, 0);
+	if (!kpcintb_workqueue) {
+		pr_err("Failed to allocate kpcintb workqueue\n");
+		return -ENOMEM;
+	}
+
 	ret = pci_epf_register_driver(&epf_ntb_driver);
 	if (ret) {
 		destroy_workqueue(kpcintb_workqueue);
-- 
